# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Cloned third-party build environments (reconstructable via repro scripts)
stance_pilot/repro/sympy_src/

# Local env / secrets
.env
*.key
*.pem

# Paper Sprint build / scratch artifacts (tectonic binary, rendered pages,
# ad-hoc inspection scripts). Not part of the frozen paper_sprint package.
stance_pilot/paper_sprint/scratch/

# LaTeX intermediate byproducts (keep main.pdf as the built artifact)
stance_pilot/paper_sprint/latex/*.aux
stance_pilot/paper_sprint/latex/*.log
stance_pilot/paper_sprint/latex/*.out
stance_pilot/paper_sprint/latex/*.toc
stance_pilot/paper_sprint/latex/*.blg
stance_pilot/paper_sprint/latex/*.xdv
stance_pilot/paper_sprint/latex/*.bbl
