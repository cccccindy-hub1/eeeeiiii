+def test_issue_12420():
+    # Test that sqrtdenest doesn't raise IndexError on expressions with complex numbers
+    # where split_surds gets an empty list of surds
+    from sympy import I
+    # This used to raise IndexError: tuple index out of range
+    result = sqrtdenest(sqrt(4 + 3*I))
+    # Verify the result is correct by squaring it
+    assert (result**2).expand() == 4 + 3*I
+
