    "bootstrap": {
      "n_boot": 10000,
      "seed": 7,
      "type": "paired percentile, resample 10 clusters",
      "unit": "instance_id"
    },
    "causal_claim_limit": "Factor effects are BEHAVIOURAL and do not uniquely identify an internal failure mechanism. An A effect supports a VERIFICATION ASSISTANCE account (counts may reduce a comparison/computation error OR merely raise operand salience; these are not separable here). A B effect supports a POLICY SALIENCE account (re-attention to the asymmetric rule OR a length/prominence nudge; not separable). A nonzero AB interaction means the two interventions are interdependent. Do NOT state that A/B isolates the model's unique internal cause of error.",
    "design_estimands": {
      "AB_interaction": "whether the reminder effect depends on counts being present (and vice-versa)",
      "A_main": "rendering main effect (counts vs none), averaged over B",
      "B_main": "policy-reminder main effect, averaged over A"
    },
    "endpoints": {
      "DA": "decision appropriateness vs frozen gold, parseable + all-request denominators",
      "NEED_to_ACCEPT": "fraction of 9 gold=NEED predicted ACCEPT per condition (Evidence Verification Failure marker)",
      "contradictory_assertion_rate": "fraction of responses whose reason asserts a verification property {identity-match, run-tree freshness, coverage complete/all-executed, all-checks-pass} while the served operands of THAT cell directly contradict it; coded from verbatim reasons against the precomputed operand fact table, blinded two-pass coding with disagreement adjudicated and agreement reported",
      "over_abstention": "gold in {ACCEPT,REJECT} predicted NEED; reported overall and split on REJECT-gold (decision-policy-failure marker)"
    },
    "interpretation_gate": "attribute an observed effect to a factor ONLY via its orthogonal arm, and only at the assistance/salience behavioural level; the A0B0 arm is the frozen Gate-2 structured observation reused, not a new call",
    "pooling": "never pooled with E1/CEE/Gate-2 raw/adjudicated scores",
    "primary_sample": "ALL 22 frozen fixtures (7 ACCEPT / 6 REJECT / 9 NEED); the 8 G2.5 cases are a pre-registered DIAGNOSTIC subset only, never the primary sample and never used to select items.",
    "unit_of_independence": "issue cluster (instance_id, n=10); mirror fixtures averaged within cluster before any contrast or bootstrap"
  },
